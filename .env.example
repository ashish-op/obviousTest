# Sickbay Polypharmacy Engine — environment template
# Copy to .env and fill values. Every external integration is env-gated:
# with credentials present the app calls real services; without them the
# adapter factory resolves to deterministic fixtures (CI has none, ever).

# --- Persistence (local SQLite) ---
# Path to the SQLite database file. Defaults to ./data/sickbay.db when unset.
# SICKBAY_DB_PATH=./data/sickbay.db

# --- Phone encryption (PRD §8: AES-256-GCM at rest) ---
# Required. 32 bytes as 64 hex chars (openssl rand -hex 32) or 44-char base64.
PHONE_ENCRYPTION_KEY=

# --- Demo seed profile ---
DEMO_PROFILE_FULL_NAME=Robert Sharma
DEMO_PROFILE_PHONE=+15550100001
DEMO_CAREGIVER_NAME=Ashish Patel
DEMO_CAREGIVER_PHONE=+15550100002

# --- Twilio (real SMS mode; fixture outbox when absent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- ConcentrateAI (vision/LLM extraction; fixtures when absent) ---
# Real extraction forwards the uploaded photo's URL to the model, so the URL
# must be publicly fetchable: run the demo behind a public origin (e.g. the
# Obvious preview URL) when exercising real extraction through the app.
CONCENTRATEAI_API_KEY=
CONCENTRATEAI_BASE_URL=https://api.concentrate.ai/v1
CONCENTRATEAI_VISION_MODEL=
